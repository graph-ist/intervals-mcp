{
  "name": "@graph-ist/intervals-mcp",
  "version": "1.0.2",
  "description": "MCP server for intervals.icu: the full public API (143 tools) plus training-load analysis, over stdio or Streamable HTTP",
  "license": "MIT",
  "author": "graph-ist",
  "homepage": "https://github.com/graph-ist/intervals-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graph-ist/intervals-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/graph-ist/intervals-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "intervals.icu",
    "training",
    "cycling",
    "running",
    "claude"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "intervals-mcp": "dist/stdio.js",
    "intervals-mcp-http": "dist/http.js"
  },
  "files": [
    "dist/",
    "!dist/**/__tests__/",
    "skills/",
    "docs/",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/stdio.js",
    "serve": "node dist/http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "check": "tsc --noEmit && biome check src/ && vitest run",
    "prepublishOnly": "npm run check && npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  }
}
